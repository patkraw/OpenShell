#!/usr/bin/env python3
"""openshell-child: create and manage child sandboxes from inside a sandbox.

A CLI over the gateway MCP door at http://openshell.local/mcp, for agents that
run shell commands but have no MCP client (the "skill + CLI" design). Like the
MCP client, it holds no credential: the sandbox's supervisor adds the identity.

  openshell-child limits
  openshell-child spawn NAME [--kind agent|tool] [--provider P] [--until-exit] -- CMD...
  openshell-child wait NAME [--timeout S]
  openshell-child exec NAME -- CMD...
  openshell-child get-file NAME PATH
  openshell-child list
  openshell-child stop NAME

Prints one JSON object per call. Exit code 1 when the gateway refuses.
"""
import argparse
import json
import os
import sys
import urllib.error
import urllib.request

URL = os.environ.get("OPENSHELL_MCP_URL", "http://openshell.local/mcp")


def rpc(method, params, rid):
    req = urllib.request.Request(
        URL,
        data=json.dumps({"jsonrpc": "2.0", "id": rid, "method": method, "params": params}).encode(),
        headers={"content-type": "application/json", "accept": "application/json, text/event-stream"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=660) as res:
            return json.loads(res.read())
    except urllib.error.HTTPError as e:
        return {"http_status": e.code, "body": e.read().decode(errors="replace")}


def call(tool, args):
    rpc("initialize", {"protocolVersion": "2025-11-25", "capabilities": {},
                       "clientInfo": {"name": "openshell-child", "version": "0"}}, 1)
    out = rpc("tools/call", {"name": tool, "arguments": args}, 2)
    result = out.get("result") or {}
    body = result.get("structuredContent")
    if body is None:
        body = out
    body = {"isError": bool(result.get("isError", "result" not in out)), **body}
    print(json.dumps(body))
    return 1 if body["isError"] else 0


def main(argv):
    if "--" in argv:
        i = argv.index("--")
        argv, cmd = argv[:i], argv[i + 1:]
    else:
        cmd = []
    p = argparse.ArgumentParser(prog="openshell-child")
    sub = p.add_subparsers(dest="op", required=True)
    sub.add_parser("limits")
    sub.add_parser("list")
    s = sub.add_parser("spawn")
    s.add_argument("name")
    s.add_argument("--kind", choices=["agent", "tool"], default="agent")
    s.add_argument("--provider", action="append", default=[])
    s.add_argument("--until-exit", action="store_true")
    w = sub.add_parser("wait")
    w.add_argument("name")
    w.add_argument("--timeout", type=int, default=60)
    e = sub.add_parser("exec")
    e.add_argument("name")
    g = sub.add_parser("get-file")
    g.add_argument("name")
    g.add_argument("path")
    st = sub.add_parser("stop")
    st.add_argument("name")
    a = p.parse_args(argv)

    if a.op == "limits":
        return call("get_limits", {})
    if a.op == "list":
        return call("list_children", {})
    if a.op == "spawn":
        args = {"name": a.name, "kind": a.kind}
        if cmd:
            args["command"] = cmd
        if a.provider:
            args["providers"] = a.provider
        if a.until_exit:
            args["lifetime"] = "until_exit"
        return call("create_sandbox", args)
    if a.op == "wait":
        return call("wait", {"handle": a.name, "timeout_s": a.timeout})
    if a.op == "exec":
        return call("exec", {"handle": a.name, "command": cmd})
    if a.op == "get-file":
        return call("get_file", {"handle": a.name, "path": a.path})
    if a.op == "stop":
        return call("stop_sandbox", {"handle": a.name})


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
