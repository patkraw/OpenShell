# mini-SWE-agent (skill + CLI, no MCP) and Deep Agents (SDK, MCP tools) for the
# harness matrix. Both run in /usr/bin/python3.11, so one grant program covers them.
FROM node:24-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates procps \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /usr/local/bin/uv

RUN uv venv --python /usr/bin/python3 /opt/mini \
    && VIRTUAL_ENV=/opt/mini uv pip install --no-cache --exclude-newer 2026-10-06 \
        "mini-swe-agent==2.4.6" "litellm==1.104.0"
COPY deepagents-constraints.txt /tmp/constraints.txt
RUN uv venv --python /usr/bin/python3 /opt/deep \
    && VIRTUAL_ENV=/opt/deep uv pip install --no-cache -c /tmp/constraints.txt \
        "deepagents==0.7.22" "langchain-openai==1.6.7" "langchain-mcp-adapters==0.3.2"

COPY --chmod=755 openshell-child /usr/local/bin/openshell-child
COPY mini-skill.yaml /etc/mini/skill.yaml
COPY deepagents_lead.py /opt/deep/deepagents_lead.py

RUN mkdir -p /workspace && chown node:node /workspace
USER node
WORKDIR /workspace
ENV MSWEA_CONFIGURED=true MSWEA_SILENT_STARTUP=1 MSWEA_COST_TRACKING=ignore_errors \
    LITELLM_LOCAL_MODEL_COST_MAP=True MSWEA_GLOBAL_CONFIG_DIR=/tmp/mswea \
    LANGSMITH_TRACING=false
