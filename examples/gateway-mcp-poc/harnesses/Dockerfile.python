# Deep Agents (SDK, MCP tools) for the harness matrix. Runs in /usr/bin/python3.11.
FROM node:24-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates procps \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /usr/local/bin/uv

COPY deepagents-constraints.txt /tmp/constraints.txt
RUN uv venv --python /usr/bin/python3 /opt/deep \
    && VIRTUAL_ENV=/opt/deep uv pip install --no-cache -c /tmp/constraints.txt \
        "deepagents==0.7.22" "langchain-openai==1.6.7" "langchain-mcp-adapters==0.3.2"

COPY deepagents_lead.py /opt/deep/deepagents_lead.py

RUN mkdir -p /workspace && chown node:node /workspace
USER node
WORKDIR /workspace
ENV LANGSMITH_TRACING=false
