# Pi coding agent for OpenShell, from docs/tutorials/run-pi-with-openrouter.mdx,
# plus the gateway MCP POC client config (Pi has built-in MCP since 0.99).
FROM node:24-bookworm-slim

ARG PI_VERSION=latest

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates fd-find git ripgrep curl \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}"

# Scripted MCP client used by the POC checks.
COPY mcp-client.mjs /usr/local/lib/gateway-mcp/mcp-client.mjs
# Official MCP TypeScript SDK and an example that uses it from inside a sandbox.
RUN npm install --prefix /usr/local/lib/gateway-mcp --ignore-scripts --no-audit --no-fund \
    "@modelcontextprotocol/sdk@1.31.0"
COPY sdk/sandbox_child.mjs /usr/local/lib/gateway-mcp/sandbox_child.mjs
# Pi config seed (copied into PI_CODING_AGENT_DIR by pi-run) and the wrapper.
COPY pi-seed/ /usr/local/share/pi-seed/
COPY --chmod=755 pi-run /usr/local/bin/pi-run
# Runs a child's task, saves its output to /tmp/result.txt and calls mark_done.
COPY --chmod=755 run-child /usr/local/bin/run-child

RUN mkdir -p /workspace && chown node:node /workspace
USER node
WORKDIR /workspace

ENV PI_CODING_AGENT_DIR=/tmp/pi-agent PI_OFFLINE=1 PI_TELEMETRY=0
