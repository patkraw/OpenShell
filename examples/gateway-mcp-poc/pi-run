#!/bin/sh
# Start Pi with the seeded config (model endpoint + gateway MCP). OPENAI_API_KEY in the
# sandbox is only a placeholder; the supervisor swaps in the real key for
# inference-api.nvidia.com, for Node only.
# `sandbox exec` does not pass the image's ENV, so set the defaults here too.
export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-/tmp/pi-agent}" PI_OFFLINE=1 PI_TELEMETRY=0
mkdir -p "$PI_CODING_AGENT_DIR"
cp -n /usr/local/share/pi-seed/*.json "$PI_CODING_AGENT_DIR"/ 2>/dev/null
# As a sandbox's main command, stdin is open but never written, and `pi -p`
# would wait for piped input forever. Close it unless it is a terminal.
[ -t 0 ] || exec </dev/null
exec pi --offline --no-approve --model nvidia/aws/anthropic/bedrock-claude-sonnet-5-5 "$@"
